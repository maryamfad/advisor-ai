# =========================
# Database (required)
# =========================
DATABASE_URL=postgresql+psycopg://advisor:advisor_dev_password@localhost:5432/advisor_ai

# =========================
# Server / CORS
# =========================
# Must point at the frontend (which serves /risk-questionnaire/{token}),
# not this API's own origin -- the risk-questionnaire shareable link is
# built from this.
# PUBLIC_BASE_URL=http://localhost:5173
# CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175"]

# =========================
# Market data (fund performance comparison)
# =========================
# Twelve Data API key. Without it, compare_funds/the performance chart
# raises a clear "not configured" error instead of the app failing to
# start.
# MARKET_DATA_API_KEY=
# MARKET_DATA_BASE_URL=https://api.twelvedata.com

# =========================
# AI assistant -- core
# =========================
# Without ANTHROPIC_API_KEY, the assistant endpoint returns 503 and the
# rest of the app works normally.
# ANTHROPIC_API_KEY=
# AI_AGENT_MODEL=claude-sonnet-5
# AI_AGENT_MAX_TOOL_ITERATIONS=6

# =========================
# AI assistant -- chat model provider
# =========================
# One of: anthropic (default), openai, ollama. Ollama's tool-calling is
# best-effort only -- see the README's limitations section.
# CHAT_MODEL_PROVIDER=anthropic
# OLLAMA_BASE_URL=http://localhost:11434

# =========================
# AI assistant -- RAG (insurance policy document search)
# =========================
# Anthropic has no embeddings API, so policy-document search uses
# OpenAI embeddings regardless of CHAT_MODEL_PROVIDER. Without
# OPENAI_API_KEY, uploading/searching insurance policy documents
# returns a clear "not configured" error (or warning, from the AI
# assistant's tool) instead of failing the whole request.
# OPENAI_API_KEY=
# EMBEDDING_MODEL_NAME=text-embedding-3-small
# PGVECTOR_COLLECTION_NAME=insurance_policy_chunks
# DOCUMENT_STORAGE_DIR=./data/documents

# =========================
# AI assistant -- LangSmith tracing (optional, off by default)
# =========================
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=advisor-ai
